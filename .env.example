# ============================================================================
#  FB Ads Autopilot
#  >> Key/Token ไม่ต้องใส่ที่นี่ — ไปกรอกเองในหน้า Dashboard ("Connect Keys")
#     ระบบเก็บลงฐานข้อมูล (ตาราง app_credentials) และไม่โชว์ค่าจริงกลับ (mask)
#     ค่า env ด้านล่างใช้เฉพาะตอนรันครั้งแรก/ค่าที่ไม่ใช่ความลับเท่านั้น
# ============================================================================

# ---- Meta / Facebook Graph API (เว้นว่างได้ ไปใส่ในเว็บเอา) --------------------
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_MARKETING_TOKEN=

# ---- AI provider (key ไปใส่ในเว็บ; ค่าไม่ใช่ความลับตั้งที่นี่ได้) ---------------
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ---- Guardrails (กรอบเหล็ก — AI auto 100% แต่ไม่มีทางเกินตัวนี้) ------------------
# เงินบาท (THB)
GUARD_DAILY_HARD_CAP=1000
GUARD_PER_CAMPAIGN_CAP=400
# ความเร็วในการใช้เงิน: ไม่ให้เผาเกิน 30% ของงบรายวัน ใน 2 ชม.แรก
GUARD_VELOCITY_WINDOW_MIN=120
GUARD_VELOCITY_MAX_PCT=30
# ROAS ต่ำกว่านี้ = auto-pause ad set ทันที (หยุดอัตโนมัติได้ แต่ห้าม "เพิ่มงบ" เองถ้าต่ำกว่านี้)
GUARD_MIN_ROAS=1.5
# ห้ามแตะ ad set ที่ conversion ยังไม่ถึง (Learning Phase)
GUARD_LEARNING_MIN_CONV=50
# โหมดซ้อม: true = AI ตัดสินใจ+log แต่ไม่ยิงจริง / false = ยิงจริง
GUARD_DRY_RUN=true

# ---- ระบบ -------------------------------------------------------------------
DATABASE_URL=postgresql://ads:ads@db:5432/ads_autopilot
BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO

# ---- ความปลอดภัย (fail-closed — ต้องตั้ง ไม่งั้นใช้ไม่ได้) ----------------------
# 1) SECURITY_KEY = คีย์เข้ารหัส secret ก่อนลง DB (สร้าง: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
SECURITY_KEY=
# 2) ADMIN_TOKEN = รหัสผ่านเข้าใช้ระบบ (ทุก API ต้องส่ง header 'X-Admin-Token: <token>')
#    ไม่ตั้ง = ทุก endpoint ยกเว้น /api/health ถูกปฏิเสธ 403
ADMIN_TOKEN=
#    (ทางเลือกปลอดภัยกว่า: เก็บ hash แทนค่าจริง สร้างด้วย security.hash_admin_token)
ADMIN_TOKEN_HASH=
# 3) CORS อนุญาตเฉพาะ origin นี้ (ห้าม *)
FRONTEND_ORIGIN=http://localhost:3000
# 4) เพดานสูงสุดที่ daily_hard_cap จะถูกขยายไปได้ (กันคน/ผู้ไม่หวังดีดันงบขึ้นมั่ว)
SYSTEM_MAX_DAILY_CAP=5000

